+import { useEffect, useState } from 'react';
+import { localApi } from '../utils/api';
+
+export function CompanionSettingsPane() {
+  const [address, setAddress] = useState('');
+  const [pairing, setPairing] = useState<{ image: string; expiresAt: number } | null>(null);
+  const [now, setNow] = useState(Date.now);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const seconds = pairing ? Math.max(0, Math.ceil((pairing.expiresAt - now) / 1000)) : 0;
+
+  useEffect(() => {
+    if (!pairing) return;
+    const timer = window.setInterval(() => setNow(Date.now()), 500);
+    return () => window.clearInterval(timer);
+  }, [pairing]);
+
+  async function createCode() {
+    setBusy(true);
+    setError('');
+    setPairing(null);
+    try {
+      const result = await localApi<{ image: string; expiresIn: number }>(
+        'companion/pairing', 'POST', { address: address.trim() },
+      );
+      const issued = Date.now();
+      setNow(issued);
+      setPairing({ image: result.image, expiresAt: issued + result.expiresIn * 1000 });
+    } catch (failure) {
+      setError(failure instanceof Error ? failure.message : 'Could not generate a pairing code.');
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <section>
+      <h2>Oracle Companion</h2>
+      <p>Connect your Android phone to the same Wi-Fi network as this PC.</p>
+      <form onSubmit={(event) => { event.preventDefault(); void createCode(); }}>
+        <label htmlFor="companion-address">Windows Wi-Fi IPv4 address</label>{' '}
+        <input id="companion-address" value={address} onChange={(event) => setAddress(event.target.value)}
+          placeholder="192.168.1.25" required disabled={busy} autoComplete="off" />
+        <p>Run <code>ipconfig</code> on Windows to find the Wi-Fi IPv4 address.</p>
+        <button type="submit" disabled={busy || !address.trim()}>
+          {busy ? 'Generating…' : pairing ? 'Generate new QR code' : 'Pair a phone'}
+        </button>
+      </form>
+      {error && <p role="alert">{error}</p>}
+      {pairing && (seconds > 0 ? (
+        <div>
+          <p>Open Oracle Companion on Android, tap <strong>Scan QR</strong>, then tap <strong>Pair this phone</strong>.</p>
+          <img alt="Oracle Companion pairing QR code" width={320} height={320}
+            style={{ maxWidth: '100%', height: 'auto', background: 'white' }}
+            src={'data:image/svg+xml;base64,' + pairing.image} />
+          <p>Expires in {seconds} seconds.</p>
+        </div>
+      ) : <p role="status">Pairing code expired. Generate a new QR code.</p>)}
+    </section>
+  );
+}
