+    def _windows_power(self, action):
+        # Use a zero Windows timeout so Windows does not implicitly force-close apps.
+        binary = os.path.join(os.environ.get("SystemRoot", r"C:\Windows"), "System32", "shutdown.exe")
+        flag = "/r" if action == "restart" else "/s"
+        try:
+            result = subprocess.run([binary, flag, "/t", "0"], capture_output=True,
+                                    timeout=5, creationflags=subprocess.CREATE_NO_WINDOW)
+        except (OSError, subprocess.TimeoutExpired):
+            raise Problem(503, "Windows did not confirm the power request.") from None
+        if result.returncode:
+            raise Problem(409, "Windows rejected the power request.")
+
+    def _record_control(self, device, status, message):
+        with self.db() as db:
+            db.execute("INSERT INTO actions VALUES (?,?,?,?,?)",
+                       (str(uuid.uuid4()), device, int(time.time()), status, message))
+
+    def _run_scheduled_shutdown(self, timer_id):
+        with self.controls_lock:
+            pending = self.scheduled_shutdown
+            if pending is None or pending["id"] != timer_id:
+                return
+            self.scheduled_shutdown = None
+            with self.db() as db:
+                still_paired = db.execute("SELECT 1 FROM devices WHERE id=?", (pending["owner"],)).fetchone()
+            if not still_paired:
+                return
+            try:
+                self._windows_power("shutdown")
+            except Problem as error:
+                self._record_control(pending["owner"], "failed", error.message)
+            else:
+                self._record_control(pending["owner"], "requested", "Windows accepted the scheduled shutdown request.")
+
+    def device_controls(self, device, command=None):
+        if os.name != "nt":
+            if command is not None:
+                raise Problem(501, "PC controls require Windows.")
+            return {"supported": False}
+        with self.controls_lock:
+            pending = self.scheduled_shutdown
+            if command is None:
+                return {"supported": True, "scheduled": {"due": pending["due"]} if pending else None,
+                        "canCancel": bool(pending and pending["owner"] == device)}
+            action = command.get("action")
+            if not isinstance(action, str) or action not in {
+                "lock", "previous", "play_pause", "next", "volume_down", "volume_up", "mute",
+                "shutdown", "restart", "schedule", "cancel"
+            }:
+                raise Problem(400, "Unknown device control.")
+            if action == "cancel":
+                if not pending or pending["owner"] != device:
+                    raise Problem(409, "No shutdown from this phone is pending.")
+                pending["timer"].cancel()
+                self.scheduled_shutdown = None
+                message = "Scheduled shutdown canceled."
+            elif action == "schedule":
+                if pending:
+                    raise Problem(409, "A shutdown is already scheduled.")
+                minutes = command.get("minutes")
+                if type(minutes) is not int or not 1 <= minutes <= 120:
+                    raise Problem(400, "Choose a delay from 1 to 120 minutes.")
+                timer_id = str(uuid.uuid4())
+                timer = threading.Timer(minutes * 60, self._run_scheduled_shutdown, args=(timer_id,))
+                timer.daemon = True
+                self.scheduled_shutdown = {"id": timer_id, "due": int(time.time()) + minutes * 60,
+                                           "timer": timer, "owner": device}
+                timer.start()
+                message = f"Shutdown scheduled in {minutes} minutes."
+            elif action in ("shutdown", "restart"):
+                if pending:
+                    raise Problem(409, "Cancel the scheduled shutdown before requesting another power action.")
+                self._windows_power(action)
+                message = "Windows accepted the power request."
+            elif action == "lock":
+                if not ctypes.windll.user32.LockWorkStation():
+                    raise Problem(409, "Windows could not start locking the current session.")
+                message = "Windows accepted the lock request."
+            else:
+                key = {"previous": 0xB1, "play_pause": 0xB3, "next": 0xB0,
+                       "volume_down": 0xAE, "volume_up": 0xAF, "mute": 0xAD}[action]
+                user32 = ctypes.windll.user32
+                user32.keybd_event(key, 0, 0, 0)
+                user32.keybd_event(key, 0, 2, 0)
+                message = "Media key sent to Windows."
+            self._record_control(device, "requested", message)
+            return {"message": message}
+
