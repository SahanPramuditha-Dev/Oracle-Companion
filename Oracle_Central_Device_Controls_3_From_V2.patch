+def display_brightness(level=None):
+    import os
+    import subprocess
+
+    executable = os.path.join(os.environ.get("SystemRoot", r"C:\Windows"), "System32",
+                              "WindowsPowerShell", "v1.0", "powershell.exe")
+    read = '$display = Get-CimInstance -Namespace root/wmi -ClassName WmiMonitorBrightness -ErrorAction Stop | Where-Object Active | Select-Object -First 1; '
+    script = read
+    if level is not None:
+        if type(level) is not int or not 5 <= level <= 100:
+            raise ValueError("Brightness outside supported range")
+        script += (
+            'if ($display) { $method = Get-CimInstance -Namespace root/wmi -ClassName WmiMonitorBrightnessMethods -ErrorAction Stop '
+            '| Where-Object { $_.InstanceName -eq $display.InstanceName } | Select-Object -First 1; '
+            'if (!$method) { exit 1 }; $result = Invoke-CimMethod -InputObject $method -MethodName WmiSetBrightness '
+            f'-Arguments @{{ Timeout=[uint32]0; Brightness=[byte]{level} }} -ErrorAction Stop; '
+            'if ($result.ReturnValue -ne 0) { exit 1 } }; ' + read
+        )
+    script += 'if ($display) { [Console]::WriteLine($display.CurrentBrightness) }'
+    try:
+        result = subprocess.run([executable, "-NoProfile", "-NonInteractive", "-Command", script],
+                                capture_output=True, text=True, timeout=5,
+                                creationflags=subprocess.CREATE_NO_WINDOW)
+    except subprocess.TimeoutExpired:
+        raise OSError("Windows brightness response timed out") from None
+    if result.returncode:
+        raise OSError("Windows brightness query failed")
+    value = result.stdout.strip()
+    return int(value) if value.isascii() and value.isdigit() and 0 <= int(value) <= 100 else None
+
+def sleep_available():
+    return bool(c.windll.powrprof.IsPwrSuspendAllowed())
+
+def suspend_pc():
+    kernel = c.WinDLL("kernel32", use_last_error=True)
+    advapi = c.WinDLL("advapi32", use_last_error=True)
+    token = w.HANDLE()
+    kernel.GetCurrentProcess.restype = w.HANDLE
+    if not advapi.OpenProcessToken(w.HANDLE(kernel.GetCurrentProcess()), 0x28, c.byref(token)):
+        raise c.WinError(c.get_last_error())
+    class Privilege(c.Structure):
+        _fields_ = [("count", w.DWORD), ("low", w.DWORD), ("high", w.LONG), ("attributes", w.DWORD)]
+    privilege = Privilege(1, 0, 0, 2)
+    previous = Privilege()
+    size = w.DWORD()
+    try:
+        if not advapi.LookupPrivilegeValueW(None, c.c_wchar_p("SeShutdownPrivilege"), c.byref(privilege, 4)):
+            raise c.WinError(c.get_last_error())
+        c.set_last_error(0)
+        if (not advapi.AdjustTokenPrivileges(token, 0, c.byref(privilege), c.sizeof(previous), c.byref(previous), c.byref(size))
+                or c.get_last_error()):
+            raise c.WinError(c.get_last_error())
+        try:
+            suspend = c.windll.powrprof.SetSuspendState
+            suspend.argtypes = [c.c_ubyte, c.c_ubyte, c.c_ubyte]
+            suspend.restype = c.c_ubyte
+            if not suspend(0, 0, 0):
+                raise OSError("Windows sleep failed")
+        finally:
+            advapi.AdjustTokenPrivileges(token, 0, c.byref(previous), 0, None, None)
+    finally:
+        kernel.CloseHandle(token)
