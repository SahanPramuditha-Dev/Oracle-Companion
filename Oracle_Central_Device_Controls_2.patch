+                user32 = ctypes.windll.user32
+                user32.keybd_event(key, 0, 0, 0)
+                user32.keybd_event(key, 0, 2, 0)
+                message = "Media key sent to Windows."
+            self._record_control(device, "requested", message)
+            return {"message": message}
